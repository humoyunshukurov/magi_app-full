{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MAGI Desktop",
  "version": "1.0.0",
  "identifier": "org.trymagi.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../frontend dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ../frontend build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MAGI Desktop",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["magi"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzNTNDOUVGRjU5RkRFQTYKUldTbTNwLzE3OGxUTTk3ZG52eHJsNWplMC9XbDJFclEwRXl6Wm4zUmNwa0E4SVpFRDlHU1NITUMK",
      "endpoints": [
        "https://github.com/humoyunshukurov/magi_app-full/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
